<script>
// ===== AimSettings (khớp với C++ struct) =====
const AimSettings = {
    aimLock: false,
    reduceShake: false,
    lightAim: false,
    stableAim: false,
    lockRadius: 150.0,
    smooth: 0.15,
    shakeReduction: 0.65
};

// Web Audio API
const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
function playClickSound() {
    if (audioCtx.state === 'suspended') audioCtx.resume();
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.type = 'sine';
    osc.frequency.setValueAtTime(800, audioCtx.currentTime);
    osc.frequency.exponentialRampToValueAtTime(400, audioCtx.currentTime + 0.05);
    gain.gain.setValueAtTime(0.1, audioCtx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.05);
    osc.connect(gain);
    gain.connect(audioCtx.destination);
    osc.start();
    osc.stop(audioCtx.currentTime + 0.05);
}

function triggerVibration() {
    if (navigator.vibrate) navigator.vibrate(15);
}

function showToast(message) {
    const toast = document.getElementById("toast");
    toast.innerText = message;
    toast.className = "show";
    setTimeout(() => { toast.className = toast.className.replace("show", ""); }, 2000);
}

document.addEventListener('gesturestart', function (e) { e.preventDefault(); });

// ===== Toggle Functions =====
function toggleFunction(element, name) {
    playClickSound();
    triggerVibration();
    element.classList.toggle("active");
    
    const isAct = element.classList.contains("active");
    showToast(`${name}: ${isAct ? 'BẬT' : 'TẮT'}`);
    
    // Cập nhật AimSettings
    if (element.id === 'btn-aimlock') AimSettings.aimLock = isAct;
    if (element.id === 'btn-antishake') AimSettings.reduceShake = isAct;
    if (element.id === 'btn-light') AimSettings.lightAim = isAct;
    if (element.id === 'btn-heavyscope') AimSettings.stableAim = isAct;

    localStorage.setItem(element.id, isAct);
    updateAdvancedPanel();
    calcEffectiveSpeed();
}

// ===== Slider Update =====
function updateSlider(id) {
    const el = document.getElementById(id);
    let val = parseFloat(el.value);
    
    if (id === 'lockRadius') {
        AimSettings.lockRadius = val;
        document.getElementById('lockRadiusVal').innerText = val.toFixed(1);
    }
    if (id === 'smooth') {
        AimSettings.smooth = val;
        document.getElementById('smoothVal').innerText = val.toFixed(2);
        calcEffectiveSpeed();
    }
    if (id === 'shakeReduction') {
        AimSettings.shakeReduction = val;
        document.getElementById('shakeReductionVal').innerText = val.toFixed(2);
    }
    
    // Lưu
    localStorage.setItem('aim_' + id, val);
}

// ===== Tính Effective Speed (theo công thức SmoothAim) =====
function calcEffectiveSpeed() {
    let speed = AimSettings.smooth;
    
    if (AimSettings.lightAim) speed *= 0.65;
    if (AimSettings.stableAim) speed *= 0.75;
    
    speed = Math.max(0.01, Math.min(1.0, speed));
    
    document.getElementById('effectiveSpeed').innerText = speed.toFixed(3);
}

// ===== Hiện/Ẩn Advanced Panel =====
function updateAdvancedPanel() {
    const panel = document.getElementById('advancedPanel');
    const hasAny = AimSettings.aimLock || AimSettings.reduceShake || AimSettings.lightAim || AimSettings.stableAim;
    
    if (hasAny) {
        panel.classList.add('show');
    } else {
        panel.classList.remove('show');
    }
    
    // Hiện từng phần
    document.getElementById('aimlockSettings').style.display = AimSettings.aimLock ? 'block' : 'none';
    document.getElementById('antishakeSettings').style.display = AimSettings.reduceShake ? 'block' : 'none';
    
    const showSmooth = AimSettings.lightAim || AimSettings.stableAim || AimSettings.aimLock;
    document.getElementById('smoothFormula').style.display = showSmooth ? 'block' : 'none';
}

// ===== Device Sensitivity =====
function getRandomInt(min, max) {
    return Math.floor(Math.random() * (max - min + 1)) + min;
}

function changeDevice() {
    playClickSound();
    triggerVibration();
    const deviceSelect = document.getElementById("device");
    const selectedDevice = deviceSelect.value;
    
    let gen, red, x2Val, x4Val, fireVal;

    if (selectedDevice.startsWith("android")) {
        gen = getRandomInt(180, 200);
        red = getRandomInt(180, 200);
        x2Val = getRandomInt(180, 200);
        x4Val = getRandomInt(180, 200);
        fireVal = getRandomInt(30, 60);
    } else {
        gen = getRandomInt(165, 200);
        red = getRandomInt(165, 200);
        x2Val = getRandomInt(165, 200);
        x4Val = getRandomInt(165, 200);
        fireVal = getRandomInt(30, 60);
    }

    document.getElementById("general").innerText = gen;
    document.getElementById("redDot").innerText = red;
    document.getElementById("x2").innerText = x2Val;
    document.getElementById("x4").innerText = x4Val;
    document.getElementById("fireValue").innerText = fireVal + "%";

    const nameText = deviceSelect.options[deviceSelect.selectedIndex].text;
    document.getElementById("deviceName").innerText = nameText;
    
    localStorage.setItem("selectedDevice", selectedDevice);
}

function startGame() {
    playClickSound();
    triggerVibration();
    
    // Log cấu hình hiện tại
    console.log("=== PRIME AIM SETTINGS ===");
    console.log(JSON.stringify(AimSettings, null, 2));
    
    showToast("Đã tối ưu hóa! Đang mở Game...");
    
    setTimeout(() => {
        window.location.href = "freefiremax://";
        setTimeout(function() {
            window.location.href = "freefire://";
        }, 500);
    }, 600);
}

// ===== Load Saved State =====
function loadSavedState() {
    const funcs = ['btn-aimlock', 'btn-light', 'btn-antishake', 'btn-heavyscope'];
    funcs.forEach(id => {
        if (localStorage.getItem(id) === 'true') {
            document.getElementById(id).classList.add('active');
            
            if (id === 'btn-aimlock') AimSettings.aimLock = true;
            if (id === 'btn-antishake') AimSettings.reduceShake = true;
            if (id === 'btn-light') AimSettings.lightAim = true;
            if (id === 'btn-heavyscope') AimSettings.stableAim = true;
        }
    });

    // Load slider values
    const savedRadius = localStorage.getItem('aim_lockRadius');
    if (savedRadius) {
        document.getElementById('lockRadius').value = savedRadius;
        AimSettings.lockRadius = parseFloat(savedRadius);
        document.getElementById('lockRadiusVal').innerText = parseFloat(savedRadius).toFixed(1);
    }
    
    const savedSmooth = localStorage.getItem('aim_smooth');
    if (savedSmooth) {
        document.getElementById('smooth').value = savedSmooth;
        AimSettings.smooth = parseFloat(savedSmooth);
        document.getElementById('smoothVal').innerText = parseFloat(savedSmooth).toFixed(2);
    }
    
    const savedShake = localStorage.getItem('aim_shakeReduction');
    if (savedShake) {
        document.getElementById('shakeReduction').value = savedShake;
        AimSettings.shakeReduction = parseFloat(savedShake);
        document.getElementById('shakeReductionVal').innerText = parseFloat(savedShake).toFixed(2);
    }

    const savedDev = localStorage.getItem("selectedDevice");
    if (savedDev) {
        document.getElementById("device").value = savedDev;
    }
    
    changeDevice();
    updateAdvancedPanel();
    calcEffectiveSpeed();
}

loadSavedState();
</script>

