<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>PRIME MENU 3.0 - Advanced</title>

<style>
*{
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    user-select: none;
    -webkit-user-select: none;
}

html, body {
    width: 100%;
    height: 100%;
    touch-action: pan-y;
    overflow-x: hidden;
}

body{
    min-height: 100vh;
    background: #02040a;
    color: #fff;
    font-family: 'Segoe UI', Arial, sans-serif;
    display: flex;
    justify-content: center;
    align-items: flex-start;
}

/* CYBER CONTAINER */
.menu{
    width: 100%;
    max-width: 400px;
    min-height: 100vh;
    padding: 20px 16px 40px;
    background: radial-gradient(circle at 50% 0%, #0d2147 0%, #040817 75%);
    border-left: 1px solid rgba(0, 210, 255, 0.2);
    border-right: 1px solid rgba(0, 210, 255, 0.2);
    box-shadow: 0 0 35px rgba(0, 150, 255, 0.15);
    position: relative;
}

/* SCANLINE EFFECT */
.menu::before {
    content: " ";
    display: block;
    position: absolute;
    top: 0; left: 0; bottom: 0; right: 0;
    background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%);
    background-size: 100% 4px;
    z-index: 10;
    pointer-events: none;
    opacity: 0.6;
}

/* HEADER */
.header{
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(0, 210, 255, 0.15);
}

.brand{
    display: flex;
    align-items: center;
    gap: 12px;
}

.logo{
    width: 45px;
    height: 45px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #00d2ff, #004080);
    box-shadow: 0 0 15px rgba(0, 210, 255, 0.5);
    font-size: 22px;
    border: 1px solid #56edff;
    animation: pulse 2s infinite alternate;
}

@keyframes pulse {
    0% { box-shadow: 0 0 10px rgba(0, 210, 255, 0.4); }
    100% { box-shadow: 0 0 22px rgba(0, 210, 255, 0.8); }
}

.title{
    font-size: 17px;
    font-weight: 900;
    letter-spacing: 1px;
    background: linear-gradient(90deg, #ffffff, #00d2ff);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.version{
    color: #00d2ff;
    font-size: 10px;
    margin-top: 2px;
    font-weight: bold;
}

.online{
    color: #00ffa3;
    font-size: 10px;
    font-weight: 800;
    display: flex;
    align-items: center;
    background: rgba(0, 255, 163, 0.08);
    padding: 4px 8px;
    border-radius: 20px;
    border: 1px solid rgba(0, 255, 163, 0.3);
}

.online i{
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 6px;
    border-radius: 50%;
    background: #00ffa3;
    box-shadow: 0 0 8px #00ffa3;
}

.menu-title{
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 14px 2px 8px;
}

.menu-title b{
    font-size: 11px;
    color: #00d2ff;
    letter-spacing: 1px;
    text-transform: uppercase;
}

.menu-title span{
    color: #4c638e;
    font-size: 9px;
    font-weight: bold;
}

/* FUNCTIONS GRID */
.functions{
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
}

.function{
    background: rgba(13, 23, 53, 0.7);
    border: 1px solid rgba(0, 150, 255, 0.2);
    border-radius: 12px;
    padding: 12px;
    min-height: 80px;
    cursor: pointer;
    transition: all 0.2s ease;
}

.function:active {
    transform: scale(0.96);
}

.function.active{
    border-color: #00d2ff;
    box-shadow: 0 0 15px rgba(0, 210, 255, 0.4);
    background: linear-gradient(135deg, rgba(0, 100, 200, 0.35), rgba(10, 25, 60, 0.85));
}

.function-top{
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.icon{
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: rgba(0, 210, 255, 0.1);
    border: 1px solid rgba(0, 210, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
}

.function-name{
    font-size: 12px;
    font-weight: 800;
    margin-top: 8px;
    color: #e0f2fe;
}

.desc{
    color: #5d75a3;
    font-size: 8.5px;
    margin-top: 2px;
}

.switch{
    width: 34px;
    height: 18px;
    border-radius: 20px;
    background: #182544;
    border: 1px solid #283a66;
    position: relative;
    transition: 0.3s;
}

.switch:after{
    content: "";
    position: absolute;
    width: 12px;
    height: 12px;
    top: 2px;
    left: 2px;
    border-radius: 50%;
    background: #516694;
    transition: 0.3s;
}

.function.active .switch{
    background: #00d2ff;
    border-color: #56edff;
    box-shadow: 0 0 8px rgba(0, 210, 255, 0.6);
}

.function.active .switch:after{
    left: 18px;
    background: #000;
}

select{
    width: 100%;
    padding: 12px;
    margin-bottom: 10px;
    border-radius: 10px;
    border: 1px solid rgba(0, 210, 255, 0.3);
    background: #09132e;
    color: #00d2ff;
    outline: none;
    font-weight: bold;
    font-size: 12px;
}

select option{ background: #070e24; color: #fff; }
select optgroup{ color: #00ffa3; background: #04091a; }

/* SENSITIVITY PANEL */
.sens-box{
    background: rgba(8, 16, 41, 0.8);
    border: 1px solid rgba(0, 210, 255, 0.25);
    border-radius: 14px;
    padding: 14px;
    margin-bottom: 12px;
}

.sens-header{
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
}

.sens-header-left{
    display: flex;
    align-items: center;
    gap: 10px;
}

.sens-icon{
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: linear-gradient(135deg, #0055ff, #002266);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    border: 1px solid rgba(0, 210, 255, 0.4);
}

.sens-name{ font-size: 12px; font-weight: bold; }
.sens-sub{ color: #00d2ff; font-size: 9px; margin-top: 1px; font-weight: bold; }

.badge{
    padding: 3px 8px;
    border-radius: 5px;
    background: rgba(0, 210, 255, 0.15);
    border: 1px solid #00d2ff;
    color: #00d2ff;
    font-size: 9px;
    font-weight: 800;
}

.row{
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(13, 23, 53, 0.6);
    border: 1px solid rgba(0, 180, 255, 0.15);
    border-radius: 8px;
    padding: 9px 12px;
    margin-top: 6px;
}

.row-left{ display: flex; align-items: center; gap: 10px; }
.row-icon{
    width: 26px; height: 26px; border-radius: 6px; background: #102048;
    display: flex; align-items: center; justify-content: center; font-size: 11px; color: #00d2ff;
}
.row-name{ font-size: 11px; font-weight: bold; }
.row-desc{ color: #4c638e; font-size: 8px; }

.value{
    min-width: 52px; padding: 5px 8px; text-align: center; border-radius: 6px;
    background: #062b54; border: 1px solid #00d2ff; color: #ffffff;
    font-size: 13px; font-weight: 900;
}

/* ADVANCED CONFIG PANEL */
.advanced-box {
    background: rgba(8, 16, 41, 0.9);
    border: 1px solid rgba(0, 210, 255, 0.3);
    border-radius: 14px;
    padding: 14px;
    margin-bottom: 12px;
    display: none;
}

.advanced-box.show {
    display: block;
    animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
}

.adv-title {
    font-size: 11px;
    color: #00d2ff;
    font-weight: 800;
    letter-spacing: 1px;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
}

.slider-row {
    margin-bottom: 14px;
}

.slider-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
}

.slider-name {
    font-size: 11px;
    font-weight: bold;
    color: #e0f2fe;
}

.slider-value {
    font-size: 12px;
    font-weight: 900;
    color: #00d2ff;
    background: rgba(0, 210, 255, 0.12);
    padding: 2px 8px;
    border-radius: 6px;
    border: 1px solid rgba(0, 210, 255, 0.3);
}

.slider-desc {
    font-size: 8px;
    color: #4c638e;
    margin-bottom: 4px;
}

input[type="range"] {
    -webkit-appearance: none;
    width: 100%;
    height: 6px;
    border-radius: 10px;
    background: #182544;
    outline: none;
    border: 1px solid #283a66;
}

input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: linear-gradient(135deg, #00d2ff, #0088cc);
    border: 2px solid #56edff;
    box-shadow: 0 0 10px rgba(0, 210, 255, 0.6);
    cursor: pointer;
}

.formula-box {
    background: rgba(0, 40, 80, 0.4);
    border: 1px dashed rgba(0, 210, 255, 0.25);
    border-radius: 8px;
    padding: 10px;
    margin-top: 8px;
    font-size: 9px;
    color: #7aa8d9;
    line-height: 1.5;
}

.formula-box b {
    color: #00d2ff;
}

.game{
    width: 100%; height: 48px; margin-top: 8px; border: 1px solid #00d2ff;
    border-radius: 10px; background: linear-gradient(90deg, #0052cc, #00a3cc);
    color: white; font-size: 13px; font-weight: 900; cursor: pointer;
    transition: all 0.2s ease;
}

.game:active {
    transform: scale(0.97);
}

.footer{ text-align: center; color: #3b4d73; font-size: 9px; font-weight: bold; margin-top: 14px; }

/* TOAST NOTIFICATION */
#toast {
    visibility: hidden;
    min-width: 200px;
    background-color: #00d2ff;
    color: #000;
    font-weight: bold;
    text-align: center;
    border-radius: 8px;
    padding: 10px;
    position: fixed;
    z-index: 100;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 12px;
    box-shadow: 0 0 15px rgba(0,210,255,0.6);
    opacity: 0;
    transition: opacity 0.3s, bottom 0.3s;
}

#toast.show {
    visibility: visible;
    opacity: 1;
    bottom: 30px;
}
</style>
</head>

