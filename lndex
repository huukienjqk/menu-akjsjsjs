                speed = settings.smooth<br>
                if (lightAim) speed *= <b>0.65</b><br>
                if (stableAim) speed *= <b>0.75</b><br>
                speed = clamp(speed, 0.01, 1.0)<br><br>
                result = current + (target - current) × speed
